{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES6",
    "rootDir": "./",
    "noEmit": true,
    "composite": true,
    "sourceMap": true,
    "strict": false,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "mocha",
      "chai",
      "node"
    ],
    "typeRoots": ["./node_modules/@types"]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "./test/**/*.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
}
