{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/parcelTypes": {
      "get": {
        "tags": ["ParcelTypes"],
        "summary": "Get all parcel types which are valid for a particular goods owner.",
        "operationId": "ParcelTypes_GetParcelTypes",
        "parameters": [
          {
            "name": "goodsOwnerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-position": 1
          }
        ],
        "responses": {
          "200": {
            "description": "A list of parcel types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "nullable": true,
                  "items": {
                    "$ref": "#/components/schemas/ParcelTypeModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ParcelTypeModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "weight": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "length": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "width": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "height": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "loadMeters": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "area": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "barCode": {
            "type": "string",
            "nullable": true
          },
          "chargePrice": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "packagingTypeCategory": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/CodeNamePair"
              }
            ]
          }
        }
      },
      "CodeNamePair": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
