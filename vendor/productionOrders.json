        "tags": [
          "ProductionOrders"
        ],
        "summary": "Get a production order using the production order ID.",
        "operationId": "ProductionOrders_GetByProductionOrderId",
        "parameters": [
          {
            "name": "productionOrderId",
            "in": "path",
            "required": true,
            "description": "Production order ID.",
