              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProductionOrderModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/productionOrders": {
      "get": {
        "tags": [
          "ProductionOrders"
        ],
