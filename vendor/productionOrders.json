            "explode": true,
            "description": "A list of production order numbers",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "string"
              }
            },
            "x-position": 2
          },
          {
            "name": "productionOrderStatusFrom",
            "in": "query",
            "description": "Minimum production order status",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 3
          },
          {
            "name": "productionOrderStatusTo",
            "in": "query",
            "description": "Maximum production order status",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 4
          },
          {
            "name": "lastProducedTimeFrom",
            "in": "query",
            "description": "Only return production orders where something has been produced after this time",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 5
          },
          {
            "name": "lastProducedTimeTo",
            "in": "query",
            "description": "Only return production orders where something has been produced before this time",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 6
          },
          {
            "name": "onlyNotFullyProducedProductionOrders",
            "in": "query",
            "description": "Only return production orders where production has started but is not yet complete",
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "x-position": 7
          },
          {
            "name": "productionOrderFreeBoolean1",
            "in": "query",
            "description": "Filter for production orders where the free boolean 1 value equals this value",
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "x-position": 8
          },
          {
            "name": "productionOrderFreeBoolean2",
            "in": "query",
            "description": "Filter for production orders where the free boolean 2 value equals this value",
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "x-position": 9
          }
        ],
        "responses": {
          "200": {
            "description": "A list of production orders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetProductionOrderModel"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ProductionOrders"
        ],
        "summary": "Create or update a production order.",
        "operationId": "ProductionOrders_PutProductionOrder",
        "requestBody": {
          "x-name": "o",
          "description": "The production order.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostProductionOrderModel"
              }
