          },
          "isPickingLocation": {
            "type": "boolean"
          },
          "isLocked": {
            "type": "boolean"
          },
          "isLockedForSale": {
            "type": "boolean"
          },
          "dimensions": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocationDimensionsModel"
              }
            ]
          }
        }
      },
      "LocationPositionModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "y": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "z": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "LocationDimensionsModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "width": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "height": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          }
        }
      }
    }
  }
}
