{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/articleItems/statuses": {
      "get": {
        "tags": ["ArticleItems"],
        "summary": "Get all article item statuses.",
        "operationId": "ArticleItems_GetArticleItemStatuses",
        "parameters": [
          {
            "name": "goodsOwnerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-position": 1
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleItemStatusModel"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["ArticleItems"],
        "summary": "Create or update an article item status. If there is no article item with the specified code, it will be created. Otherwise, the existing status will be updated.",
        "operationId": "ArticleItems_PutArticleItemStatus",
        "requestBody": {
          "x-name": "m",
          "description": "An object containing the article item status data.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostArticleItemStatusModel"
              }
            }
          },
          "required": true,
          "x-position": 1
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostArticleItemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/articleItems": {
      "get": {
        "tags": ["ArticleItems"],
        "summary": "Get all article items which match the specified search criteria. The search criteria are specified as query parameters.",
        "operationId": "ArticleItems_GetArticleItems",
        "parameters": [
          {
            "name": "goodsOwnerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-position": 1
          },
          {
            "name": "articleNumber",
            "in": "query",
            "description": "Only return article items for this article number (only 1 article number may be specified).",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "x-position": 2
          },
          {
            "name": "articleSystemIdFrom",
            "in": "query",
            "description": "Only return articles whose article system ID is greater than or equal to this.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 3
          },
          {
            "name": "maxArticlesToGet",
            "in": "query",
            "description": "Maximum number of articles to return.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 4
          },
          {
            "name": "articleNumbers",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Only return article items for these article numbers (several article numbers may be specified).",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "string"
              }
            },
            "x-position": 5
          },
          {
            "name": "locationNames",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Only return article items which are at these locations (several location names may be specified).",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "string"
              }
            },
            "x-position": 6
          },
          {
            "name": "articleItemStatusCodes",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Only return article items which are assigned with these article item statuses (several article item status codes may be specified).",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "string"
              }
            },
            "x-position": 7
          },
          {
            "name": "batchNumbers",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Only return article items with these batch numbers (several batch numbers may be specified).",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "string"
              }
            },
            "x-position": 8
          }
        ],
        "responses": {
          "200": {
            "description": "A list of article items, specified per article",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "nullable": true,
                  "items": {
                    "$ref": "#/components/schemas/GetArticleItemsModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/articleItems/byQuery": {
      "post": {
        "tags": ["ArticleItems"],
        "summary": "Get all article items which match the specified search criteria. The search criteria are specified in the request body.",
