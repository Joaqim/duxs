{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/invoices": {
      "get": {
        "tags": ["Invoices"],
        "summary": "Get all invoices which match the specified search criteria. This function requires an additional permission for the API user, see Administration->Integration->API for goods owners.",
        "operationId": "Invoices_Get",
        "parameters": [
          {
            "name": "goodsOwnerId",
            "in": "query",
            "required": true,
            "description": "Goods owner ID.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-position": 1
          },
          {
            "name": "invoiceIds",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Only return the specific invoice IDs.",
            "schema": {
              "type": "array",
              "nullable": true,
              "items": {
                "type": "integer",
                "format": "int32"
              }
            },
            "x-position": 2
          },
          {
            "name": "isExported",
            "in": "query",
            "description": "Filter for invoices which have (or have not) been marked as exported.",
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "x-position": 3
          },
          {
            "name": "invoiceExportedDateFrom",
            "in": "query",
            "description": "Only return invoices which have been exported after this date.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 4
          },
          {
            "name": "invoiceExportedDateTo",
            "in": "query",
            "description": "Only return invoices which have been exported before this date.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 5
          },
          {
            "name": "invoiceDateFrom",
            "in": "query",
            "description": "Only return invoices whose invoice date is later than this.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 6
          },
          {
            "name": "invoiceDateTo",
            "in": "query",
            "description": ">Only return invoices whose invoice date is earlier than this.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "x-position": 7
          },
          {
            "name": "invoiceIdFrom",
            "in": "query",
            "description": ">Only return invoices whose IDs are larger than this.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 8
          },
          {
            "name": "maxInvoicesToGet",
            "in": "query",
            "description": "Maximum number of invoices to return.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "x-position": 9
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetInvoiceModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/{invoiceId}": {
      "get": {
        "tags": ["Invoices"],
        "summary": "Get an invoice. This function requires an additional permission for the API user, see Administration->Integration->API for goods owners.",
        "operationId": "Invoices_GetById",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "description": "Invoice ID.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-position": 1
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInvoiceModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
